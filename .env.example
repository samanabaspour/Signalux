# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://signalux.ir"
GSC_VERIFICATION_CODE=

# Optional customer sign-in services (server environment only)
GOOGLE_CLIENT_ID=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_ID=

# WEB3FORMS_ACCESS_KEY
VITE_WEB3FORMS_ACCESS_KEY=

# Server & Environment
NODE_ENV="development"
PORT=3000

# Database Connection (MySQL / MariaDB for DirectAdmin Host)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/signalux"

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Seed Initial Super Admin
INITIAL_ADMIN_EMAIL="admin@signalux.ir"
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME="مدیر"
INITIAL_ADMIN_LAST_NAME="ارشد"

