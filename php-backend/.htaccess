# Install this file at the document root. The PHP public entry point is /api/index.php.
Options -Indexes
<FilesMatch "(?i)^(?:\..*|config\.php|auth\.php|db\.php|jwt\.php|response\.php|bootstrap-admin\.php|.*\.(?:sql|log|bak|md))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^api/(?:Core|Controllers)(?:/|$) - [F,L,NC]
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^api/index\.php$ - [END]
    RewriteRule ^(?:api(?:/.*)?|robots\.txt|sitemap\.xml|index\.html)?$ /api/index.php [END]
    RewriteRule ^assets(?:/|$) - [END]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /api/index.php [END]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
